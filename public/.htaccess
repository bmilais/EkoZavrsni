# Dopusti pristup ovoj mapi. Korijenski .htaccess projekta zabranjuje sve
# ostalo, a ova linija za public/ tu zabranu ponistava.
Require all granted

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /EkoZavrsni/public/

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^api(/.*)?$ api.php [QSA,L]

  RewriteRule ^ index.php [L]
</IfModule>
